# Copy this file to .env.local in the project root, beside package.json.
# Paste your PostgreSQL connection string between the quotes.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Required: the store cannot load its catalog while this is blank.
# On Vercel, add this in the project's Environment Variables settings too.
# For Supabase serverless hosting, copy the transaction pooler URI from Connect.
# URL-encode special characters in the username/password (for example, @ as %40).
# Next.js expands $VARIABLE in env values; escape a literal dollar sign as \$.
DATABASE_URL=""

# Prefer the TLS settings in your provider's connection string (e.g. sslmode=require).
# Leave false for local PostgreSQL and when TLS is configured in DATABASE_URL.
# The existing DATABASE_SSL=true override disables certificate verification.
DATABASE_SSL=false

# Customer accounts require a session secret of at least 32 characters.
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CUSTOMER_SESSION_SECRET=""

# Optional: configure these three values to enable the admin login.
ADMIN_EMAIL=""
# Generate a hash with the admin:hash-password npm script; see README.md.
ADMIN_PASSWORD_HASH=""
# Generate a separate random secret using the command above (at least 32 characters).
ADMIN_SESSION_SECRET=""

# Gemini equipment shopping assistant. Server-only: never use NEXT_PUBLIC_ for this key.
GEMINI_API_KEY=""
# Use a model available to your Gemini API project.
GEMINI_MODEL="gemini-3.6-flash"
# Only enable behind a proxy that replaces, rather than trusts, incoming X-Forwarded-For.
CHATBOT_TRUST_PROXY=false
